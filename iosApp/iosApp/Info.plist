<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- 네이버 지도 iOS SDK 인증 키. 값은 Configuration/Config.xcconfig 의 NAVER_NCP_KEY_ID 에서 온다. -->
	<key>NMFNcpKeyId</key>
	<string>$(NAVER_NCP_KEY_ID)</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>주변 식당·카페·빵집을 지도에 보여주기 위해 위치 정보를 사용합니다.</string>
	<!-- 길찾기: 네이버 지도 앱(nmap://)을 열 수 있는지 확인하기 위해 필요 -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>nmap</string>
	</array>
</dict>
</plist>
